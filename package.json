{
	"name": "pixex",
	"version": "0.1.0",
	"description": "Pixelmator Export. TypeScript library and CLI tool to automate layer composition and exports from Pixelmator Pro PXD files.",
	"keywords": [
		"cli",
		"pixelmator",
		"applescript",
		"pxd",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/pixex",
	"bugs": "https://github.com/kitschpatrol/pixex/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/pixex.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"pixex": "dist/bin/cli.js"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"fixture:generate": "node scripts/generate-fixture.ts",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"lognow": "^0.8.4",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.10.0",
		"@types/node": "~24.13.3",
		"@types/yargs": "^17.0.35",
		"brewpub": "^0.4.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.2.0",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"os": [
		"darwin"
	]
}
